// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Problem {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  difficulty Difficulty
  content    String
  tags       String[]
  createdAt  DateTime   @default(now())

  codeSnippets CodeSnippet[]
  userMeta     UserProblemMeta[]
  posts        Post[]
  submissions  Submission[]
}

model CodeSnippet {
  id       String @id @default(cuid())
  lang     String
  langSlug String
  code     String

  problem   Problem @relation(fields: [problemId], references: [id])
  problemId String
}

model UserProblemMeta {
  id       String @id @default(cuid())
  username String
  slug     String

  note     String?
  status   LearningStatus
  autoTags String[]

  updatedAt DateTime @updatedAt

  problem   Problem @relation(fields: [problemId], references: [id])
  problemId String

  @@unique([username, slug])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  type      PostType
  published Boolean  @default(false)

  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostType {
  BLOG
  SOLUTION
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum LearningStatus {
  UNREAD
  UNDERSTOOD
  CONFUSED
  NEED_REVIEW
}

model Submission {
  id String @id @default(cuid())

  // Core fields from recentAcSubmissionList
  submissionId String // LeetCode submission ID (use to build URL)
  username     String
  title        String
  slug         String
  timestamp    Int // UNIX timestamp

  // Performance metrics
  runtime           Int // milliseconds
  runtimePercentile Float?
  runtimeDisplay    String?

  memory           BigInt?
  memoryPercentile Float?
  memoryDisplay    String?

  lang       String // java, python, cpp, etc.
  statusCode Int // 10 = Accepted

  // Code & Solution
  code  String  @db.Text
  notes String? @db.Text

  // Problem metadata
  difficulty Difficulty?
  topics     String[]
  questionId String?

  // Statistics
  totalCorrect   Int?
  totalTestcases Int?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id])

  trackedUser   TrackedUser? @relation(fields: [trackedUserId], references: [id])
  trackedUserId String?

  @@unique([username, submissionId])
  @@index([username])
  @@index([slug])
  @@index([timestamp])
  @@index([difficulty])
  @@index([lang])
}

model TrackedUser {
  id          String    @id @default(cuid())
  username    String    @unique // LeetCode username
  enabled     Boolean   @default(true) // Enable/disable tracking
  lastFetched DateTime? // Lần fetch cuối cùng
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions Submission[] // Relation to submissions

  @@index([enabled]) // For cron job query
  @@index([lastFetched])
}
